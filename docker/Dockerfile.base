FROM ghcr.io/cyber-dojo-languages/javascript-node:7432bb4@sha256:f3bd3882f4b1dc12cc86b3d778379b444f497526b6e2884667243a65cf37271f
LABEL maintainer=jon@jaggersoft.com

# https://github.com/cucumber/cucumber-js/blob/master/docs/cli.md
# Says
# <quote>
# Note on global installs: Cucumber does not work when installed globally
# because cucumber needs to be required in your support files and globally
# installed modules cannot be required.
# </quote>
# So do not do $ npm install -global cucumber

USER sandbox
WORKDIR /home/sandbox
RUN npm install @cucumber/cucumber
ENV NODE_PATH=/home/sandbox/node_modules/

# /versions.json belongs to root, so the record is written as root, and the
# image then goes back to the sandbox user it ran as before.
USER root
COPY install.sh /tmp/
RUN /tmp/install.sh && rm /tmp/install.sh
USER sandbox
